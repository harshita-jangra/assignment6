# Port configuration (Using 5001 on macOS to avoid port 5000 AirPlay collision)
PORT=5001

# MongoDB Connection String (Replace with your local URI or MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017/helpdesk_db

# JWT Secret key for signing tokens
JWT_SECRET=replace_with_a_secure_random_secret_key

# Frontend application URL for CORS configuration
CLIENT_URL=http://localhost:5173

# Node environment mode (development or production)
NODE_ENV=development
